#include <stdio.h>

int main() 
{ 
    float units, total_bill; // Fixed variable name to 'units' to match the rest of the code

    printf("Enter the total units consumed: "); 
    
    if (scanf("%f", &units) != 1 || units < 0) { 
        printf("Invalid input. Units consumed cannot be negative.\n"); 
        return 1; 
    } 

    if (units <= 100) { 
        total_bill = units * 1.50; 
    } else if (units <= 200) { 
        total_bill = units * 2.50; // Changed from 22.50 to 2.50 assuming a typo
    } else if (units <= 500) { 
        total_bill = units * 4.00; // Adjusted for a standard progressive logic (Optional)
    } else { 
        total_bill = units * 6.00; // Adjusted for a standard progressive logic (Optional)
    } 

    printf("Total Electricity Bill: %.2f\n", total_bill); 
    
    return 0;
}
